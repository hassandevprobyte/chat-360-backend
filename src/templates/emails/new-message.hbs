<h1 style="margin:0 0 16px;font-size:21px;">New message from {{visitorName}}</h1>
<p style="margin:0 0 12px;">You have a new message in a conversation you are handling in <strong>{{workspaceName}}</strong>.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:16px 0;width:100%;background:#f8fafc;border-radius:8px;">
  <tr><td style="padding:16px;font-size:14px;line-height:1.6;color:#475569;">{{preview}}</td></tr>
</table>
{{> button url=conversationUrl label="Reply now"}}
