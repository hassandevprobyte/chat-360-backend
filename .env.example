# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=LiveChat
APP_URL=http://localhost:4000
API_URL=http://localhost:4000/api/v1
DASHBOARD_URL=http://localhost:3000
WIDGET_URL=http://localhost:3001
# Comma separated list of origins allowed to call the DASHBOARD api.
# The PUBLIC widget api is origin-checked per widget (allowedDomains) instead.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false

# ----------------------------------------------------------------------------
# MongoDB
# ----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/livechat
MONGO_DEBUG=false

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=livechat
# Set to true ONLY for isolated unit/integration testing (uses in-process stub)
REDIS_DISABLED=false

# ----------------------------------------------------------------------------
# JWT / sessions
# ----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_WIDGET_SECRET=change-me-widget-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_WIDGET_EXPIRES_IN=7d
EMAIL_TOKEN_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
INVITATION_EXPIRES_IN=7d
# Send refresh tokens as an httpOnly cookie in addition to the JSON body
REFRESH_COOKIE_ENABLED=true
REFRESH_COOKIE_NAME=lc_rt
COOKIE_DOMAIN=

# ----------------------------------------------------------------------------
# SMTP / email
# ----------------------------------------------------------------------------
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LiveChat <no-reply@example.com>"

# ----------------------------------------------------------------------------
# Storage / attachments
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE=10485760
# S3 compatible (only required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
BODY_LIMIT=100kb

# ----------------------------------------------------------------------------
# Caching / presence
# ----------------------------------------------------------------------------
WIDGET_CONFIG_CACHE_TTL=300
PRESENCE_TTL=90

# ----------------------------------------------------------------------------
# Workers
# ----------------------------------------------------------------------------
WORKER_CONCURRENCY=5
ENABLE_SCHEDULED_JOBS=true

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# ----------------------------------------------------------------------------
# Seed (never commit real credentials)
# ----------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_DEMO=true
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=
